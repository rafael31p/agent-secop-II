# Copia este archivo a .env y rellena solo el proveedor que vayas a usar.
# .env está en .gitignore: no lo subas al repositorio.
#
# Toda propiedad de application.properties tiene aquí su equivalente en
# mayúsculas con guion bajo, p. ej. agente.ia.gemini.api-key ->
# AGENTE_IA_GEMINI_API_KEY.
#
# Cuidado con dejar una variable escrita y vacía: SmallRye la convierte a nulo y
# el arranque falla con SRCFG00040 si la propiedad no es opcional. Si no la vas a
# usar, coméntala en lugar de dejarla en blanco.

# --- Proveedor por defecto cuando la petición no especifica uno ---
AGENTE_IA_PROVEEDOR_POR_DEFECTO=gemini

# --- Google Gemini: https://aistudio.google.com/apikey ---
AGENTE_IA_GEMINI_API_KEY=
AGENTE_IA_GEMINI_MODELO_POR_DEFECTO=gemini-3.6-flash

# --- OpenAI: https://platform.openai.com/api-keys ---
# AGENTE_IA_OPENAI_API_KEY=

# --- Anthropic: https://console.anthropic.com ---
# AGENTE_IA_ANTHROPIC_API_KEY=

# --- DeepSeek: https://platform.deepseek.com ---
# AGENTE_IA_DEEPSEEK_API_KEY=

# --- Ollama local: requiere el servidor levantado en localhost:11434 ---
# AGENTE_IA_OLLAMA_HABILITADO=true

# --- SECOP II: token opcional de datos.gov.co, sube el límite de peticiones ---
# AGENTE_SECOP_APP_TOKEN=
