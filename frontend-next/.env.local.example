# Copia este archivo a .env.local y ajusta si el backend no está en localhost:8000.
#
# Se llama al backend directamente (no por un proxy de Next) para no romper el
# streaming del chat. El backend ya autoriza por CORS los puertos 3000 y 5173;
# si lo publicas en otro origen, añádelo a quarkus.http.cors.origins.
#
# Déjalo vacío (NEXT_PUBLIC_API_URL=) si sirves front y back tras el mismo dominio.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clave con la que el backend identifica a este cliente. En desarrollo no hace
# falta: `quarkus:dev` desactiva la autenticación. En cualquier despliegue real
# sí, y sin ella los endpoints que llaman al modelo responden 401.
#
# Ojo: al llevar el prefijo NEXT_PUBLIC_ queda embebida en el paquete que
# descarga el navegador. No es un secreto frente al usuario de la aplicación y
# no pretende serlo: evita que un tercero sin acceso gaste el presupuesto de
# tokens, no autentica personas.
# NEXT_PUBLIC_API_KEY=
