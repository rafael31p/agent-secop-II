# --- Google Gemini ---
# Obtén la key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Los modelos se retiran con el tiempo y el acceso depende de tu plan.
# Ejecuta `python listar_modelos.py`: sondea cada modelo con una llamada real y te dice
# cuáles puedes usar de verdad (aparecer en el catálogo no basta).
#
# gemini-3.6-flash    -> económico y capaz; predeterminado
# gemini-3.5-flash    -> alternativa de la generación anterior
# *-flash-lite        -> más barato y sin razonamiento; peor en análisis normativo
# gemini-*-pro-*      -> mejor en pliegos largos o ambiguos, PERO requiere plan de pago
#                        (en el plan gratuito devuelven 429)
GEMINI_MODEL=gemini-3.6-flash

# Incluye los tokens de razonamiento de Gemini 2.5; deja margen suficiente.
GEMINI_MAX_TOKENS=32000

# Baja: el trabajo es extracción y verificación, no redacción creativa.
GEMINI_TEMPERATURE=0.2

# Presupuesto de razonamiento. Vacío = el modelo decide (recomendado).
# 0 lo desactiva: más barato y rápido, pero peor en análisis normativo.
# Máximo 24576 en los modelos 2.5.
GEMINI_THINKING_BUDGET=

# --- SECOP II / datos.gov.co (Socrata) ---
# Token opcional: sube el rate limit de la API abierta.
# Se obtiene gratis en https://www.datos.gov.co/profile/edit/developer_settings
SECOP_APP_TOKEN=
SECOP_BASE_URL=https://www.datos.gov.co/resource
SECOP_PROCESOS_DATASET=p6dx-8zbt
SECOP_CONTRATOS_DATASET=jbjy-vk9h

# --- App ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
